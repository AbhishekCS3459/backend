# Local development: Docker Postgres from docker-compose (make docker-up).
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/find_me?sslmode=disable
JWT_SECRET=dev-secret-change-in-production
API_ACCESS_TOKEN=
# Customer UI (ui/customer-ui/customer-ui, pnpm dev on port 3002)
CORS_ALLOWED_ORIGINS=http://localhost:3002

# First admin (created on startup only if no admin exists)
BOOTSTRAP_ADMIN_EMAIL=admin@findme.local
BOOTSTRAP_ADMIN_PASSWORD=changeme123
BOOTSTRAP_ADMIN_PHONE=+10000000000
