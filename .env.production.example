# Production database, for running the API locally against prod: make run-prod
# The deployed app does not read this file; Azure App Settings provide its config.
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@todays-database-dev.postgres.database.azure.com:5432/find_me?sslmode=require
# Use the same value as the Azure app setting so tokens work in both places:
# az webapp config appsettings list -g todayz-app -n find-me-api --query "[?name=='JWT_SECRET'].value" -o tsv
JWT_SECRET=
API_ACCESS_TOKEN=
