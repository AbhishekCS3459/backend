# =============================================================================
# Find Me Backend - Shared Environment Variables
# =============================================================================
# Env files are selected by ENVIRONMENT (default: development):
#   cp .env.example .env
#   cp .env.development.example .env.development   # local Docker database
#   cp .env.production.example .env.production     # optional: run locally against prod
#
# Load order (first wins):
#   real env vars > .env.$ENVIRONMENT.local > .env.local > .env.$ENVIRONMENT > .env
# The deployed app gets its config from Azure App Settings, not from these files.

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8080
LOG_LEVEL=info

# Extra browser origins allowed by CORS, comma separated (e.g. the customer UI)
CORS_ALLOWED_ORIGINS=

# =============================================================================
# Marketplace (public customer search)
# =============================================================================
# Stock not confirmed for longer than this shows as CONFIRM_WITH_STORE
MARKETPLACE_STALE_AFTER=336h
# true lets requests with "X-Debug: 1" see exact quantities. Ignored in production.
DEBUG_MARKETPLACE=false
# Live availability streams one client address may hold open (needs REDIS_URL)
MARKETPLACE_LIVE_MAX_PER_IP=30

# =============================================================================
# Outbox
# =============================================================================
OUTBOX_PUBLISHER_ENABLED=true
# Pause between polls once the outbox is empty: the usual delay of a live update
OUTBOX_POLL_INTERVAL=250ms

# =============================================================================
# Orders (pickup at the store)
# =============================================================================
# How long an online order holds its stock while the customer pays
ORDER_PAYMENT_HOLD=10m
# How long a store has to accept an order before it is rejected and the stock freed
ORDER_ACCEPT_TIMEOUT=15m
# How long a ready order waits for the customer before it counts as a no-show
ORDER_PICKUP_WINDOW=2h
# Derives the customer's pickup codes. Empty derives one from JWT_SECRET;
# changing it changes the code of every open order.
ORDER_PICKUP_SECRET=
# Closes overdue orders and retries refunds. Safe on several instances at once.
ORDER_SWEEPER_ENABLED=true
ORDER_SWEEP_INTERVAL=30s
# Payment gateway. Only "dummy" exists so far: payments are completed from the app.
PAYMENT_PROVIDER=dummy

# =============================================================================
# MongoDB
# =============================================================================
# Leave empty to disable the catalogue. URL-encode special characters in the password.
DATABASE_URL_MONGODB_PROD=mongodb+srv://todayzadmin:<db_password>@cluster-0.am2gdhw.mongodb.net/?appName=cluster-0

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SEC=10.0
RATE_LIMIT_BURST=20

# =============================================================================
# Queue System (OPTIONAL)
# =============================================================================
# Redis URL for background job processing. Leave empty for the in-memory queue.
# Format: redis://host:port or redis://user:password@host:port/db
QUEUE_URL=

# Redis URL for queue-monitor, test-queue, Truecaller session cache and live
# marketplace stock updates. Leave empty to cache Truecaller sessions in memory
# and have customers poll for stock changes instead.
REDIS_URL=

# Test database URL (for running tests). If not set, tests use DATABASE_URL.
TEST_DATABASE_URL=
